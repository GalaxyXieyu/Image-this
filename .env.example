# 环境变量示例
# 复制此文件为 .env（开发）或 .env.production（生产构建）并填写实际值

# 数据库
# 开发用默认 SQLite 路径；生产构建时建议改为 file:./prisma/prod.db
DATABASE_URL="file:./app.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:23000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"

# Desktop auto-update
# 开发：使用本地 broker
DESKTOP_UPDATE_BASE_URL="http://localhost:23000"
GITHUB_RELEASE_TOKEN=""
GITHUB_RELEASE_OWNER=""
GITHUB_RELEASE_REPO=""

# 生产：使用 electron-updater generic feed（覆盖上面的 legacy broker）
# DESKTOP_UPDATE_FEED_URL="https://github.com/OWNER/REPO/releases/latest/download"

# AI 图片服务（可选，留空则使用数据库中存储的用户级密钥）
GPT_API_URL="https://toapis.com"
GPT_API_KEY=""
GPT_MODEL_NAME="gpt-image-2"
GEMINI_BASE_URL="https://toapis.com"
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-3.1-flash-image-preview"
VOLCENGINE_ACCESS_KEY=""
VOLCENGINE_SECRET_KEY=""
ARK_API_KEY=""
JIMENG_BASE_URL="https://ark.cn-beijing.volces.com/api/v3/images/generations"
JIMENG_MODEL="seedream-4.5"
SUPERBED_TOKEN=""

# Legacy / other AI 服务（可选）
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GOOGLE_AI_API_KEY="..."

# 图像存储（可选）
# MINIO_ENDPOINT="localhost"
# MINIO_PORT="9000"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_BUCKET="images"
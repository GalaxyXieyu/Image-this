              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "bugSyncBody",
              "fill": "#CBD5E1",
              "content": "顶部导航统一为 ImageThis / 首页 / 模板库 / 任务中心 / 结果管理 / 设置；首页使用当前 Hero、三步流程、品类场景和 CTA；模板库保留分类、组合模板、搜索、排序、卡片操作；场景工作台以产品信息、平台、素材上传三段为首屏；工具箱以统一智能工具箱和任务结果闭环为主；任务/结果/设置按当前本地运行态收敛。",
              "fontFamily": "Geist",
              "fontSize": 16,
              "lineHeight": 1.6,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  hashedPassword String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // API 配置
  volcengineAccessKey String? // 火山引擎 Access Key
  volcengineSecretKey String? // 火山引擎 Secret Key
  hasVolcengineCredentials Boolean @default(false)
  gptApiUrl           String? // GPT API 地址
  gptApiKey           String? // GPT API Key
  gptModelName        String? // GPT 默认模型（兼容旧字段，= models 列表里第一个启用项）
  gptModelsJson       String? // GPT 模型列表 JSON，元素结构 { id, enabled }
  hasGptApiKey        Boolean @default(false)
  geminiApiKey        String? // Gemini API Key
  geminiBaseUrl       String? // Gemini Base URL
  geminiModelName     String? // Gemini 默认模型
  geminiModelsJson    String? // Gemini 模型列表 JSON
  hasGeminiApiKey     Boolean @default(false)
  arkApiKey           String? // 即梦 Ark API Key
  jimengBaseUrl       String? // 即梦 Base URL
  jimengModelName     String? // 即梦 默认模型
  jimengModelsJson    String? // 即梦 模型列表 JSON
  hasJimengCredentials Boolean @default(false)
  copywriterApiKey    String? // 文案/出词多模态模型 API Key
  copywriterBaseUrl   String? // 文案/出词模型 Base URL（OpenAI 兼容，如 https://toapis.com/v1）
  copywriterModelName String? // 文案/出词模型名（如 gpt-5.4-mini）
  hasCopywriterApiKey Boolean @default(false)
  superbedToken       String? // Superbed 图床 Token
  hasSuperbedToken    Boolean @default(false)
  localStoragePath    String? // 本地文件保存路径（默认为 public/uploads）
  taskConcurrency     Int     @default(2) // 后台任务最大并发数
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  processedImages ProcessedImage[]
  taskQueue     TaskQueue[]
  promptTemplates PromptTemplate[]
  workflowTemplates WorkflowTemplate[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Application specific models
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedImages ProcessedImage[]
  taskQueue       TaskQueue[]

  @@map("projects")
}

model ProcessedImage {
  id               String           @id @default(cuid())
  filename         String
  originalUrl      String
  processedUrl     String?
  thumbnailUrl     String?
  processType      String
  status           String           @default("PENDING")
  errorMessage     String?
  metadata         String?          // 存储处理参数和其他元数据（JSON字符串）
  fileSize         Int?
  width            Int?
  height           Int?
  qualityScore     Int?             // 质量评分 1-10
  qualityReview    String?          // 质量审核详情（JSON字符串）
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  // Relations
  userId           String
  projectId        String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskQueue        TaskQueue[]

  @@index([userId, status])
  @@index([userId, processType])
  @@index([userId, createdAt])
  @@index([projectId])
  @@map("processed_images")
}

// ProcessType 常量（SQLite不支持enum）:
// "BACKGROUND_REMOVAL" - 背景替换
// "IMAGE_EXPANSION" - 扩图  
// "IMAGE_UPSCALING" - 高清化
// "ONE_CLICK_WORKFLOW" - 一键处理
// "GPT_GENERATION" - GPT生成

// ProcessStatus 常量（SQLite不支持enum）:
// "PENDING" - 等待处理
// "PROCESSING" - 处理中
// "COMPLETED" - 已完成
// "FAILED" - 失败
// "CANCELLED" - 已取消

// 异步任务队列模型
model TaskQueue {
  id               String        @id @default(cuid())
  type             String        // 任务类型
  status           String        @default("PENDING")
  priority         Int           @default(1) // 优先级，数字越大优先级越高
  progress         Float         @default(0) // 进度百分比 0-100
  currentStep      String?       // 当前处理步骤描述
  totalSteps       Int           @default(1) // 总步骤数
  completedSteps   Int           @default(0) // 已完成步骤数
  
  // 重试机制
  retryCount       Int           @default(0) // 已重试次数
  maxRetries       Int           @default(3) // 最大重试次数
  
  // 任务数据
  inputData        String        // 输入数据（图片URL、参数等）JSON字符串
  outputData       String?       // 输出结果 JSON字符串
  errorMessage     String?       // 错误信息
  
  // 契约版本与类型标识（Phase 5 新增，向下兼容）
  contractVersion  Int           @default(1) // 1 = legacy loose JSON, 2 = typed workflow contract
  workflowType     String?                    // normalized workflow type (scene_generation, background_replace, etc.)
  handlerName      String?                    // worker handler registry key

  // 时间戳
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  startedAt        DateTime?     // 开始处理时间
  completedAt      DateTime?     // 完成时间

  // 关联
  userId           String
  projectId        String?
  processedImageId String?       // 关联到处理结果
  
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  processedImage   ProcessedImage? @relation(fields: [processedImageId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, priority])
  @@index([userId, createdAt])
  @@index([status])  // 单独 status 索引，优化 groupBy 统计查询
  @@map("task_queue")
}

// 提示词模板模型
model PromptTemplate {
  id          String   @id @default(cuid())
  name        String   // 模板名称
  description String?  // 模板描述
  category    String   // 模板分类：BACKGROUND_REPLACE, OUTPAINT, UPSCALE, ONE_CLICK
  prompt      String   // 提示词内容（当前生效版本内容的冗余镜像，向后兼容）
  isDefault   Boolean  @default(false) // 是否为默认模板
  isSystem    Boolean  @default(false) // 是否为系统预设模板（不可删除）
  activeVersionId String? // 当前生效版本（-> PromptTemplateVersion.id）

  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    PromptTemplateVersion[]
  comparisons PromptComparison[]

  @@index([userId, category])
  @@index([userId, isDefault])
  @@map("prompt_templates")
}

// 提示词版本：一个模板多个版本（历史 / 多版本对比）
model PromptTemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String   // 归属用户（冗余，便于按用户过滤；级联经由 template 保证）
  versionNo  Int      // 模板内自增版本号（1,2,3…）
  label      String?  // 可选版本名
  content    String   // 该版本提示词正文
  note       String?  // 备注 / 改动说明
  createdAt  DateTime @default(now())

  @@index([templateId, versionNo])
  @@map("prompt_template_versions")
}

// 对比实验：一次"多版本 × 多模型 对同一张测试图"的运行
model PromptComparison {
  id           String   @id @default(cuid())
  templateId   String
  template     PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId       String
  testImageUrl String   // 输入测试图（引用 / 路径，不存 base64）
  note         String?
  createdAt    DateTime @default(now())
  cells        PromptComparisonCell[]

  @@index([templateId, createdAt])
  @@map("prompt_comparisons")
}

// 对比结果格：一格 = 一个 (版本 × 模型) 的运行结果
model PromptComparisonCell {
  id               String   @id @default(cuid())
  comparisonId     String
  comparison       PromptComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  versionId        String   // 参与对比的版本
  versionNo        Int      // 冗余版本号（回看时版本可能已删）
  provider         String
  modelName        String
  taskId           String?  // -> TaskQueue.id（弱关联）
  processedImageId String?  // -> ProcessedImage.id 结果
  status           String   @default("PENDING") // PENDING/PROCESSING/COMPLETED/FAILED
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([comparisonId])
  @@map("prompt_comparison_cells")
}

// PromptTemplate Category 常量:
// "BACKGROUND_REPLACE" - 背景替换提示词
// "OUTPAINT" - 扩图提示词
// "UPSCALE" - 高清化提示词
// "ONE_CLICK" - 一键增强提示词

// 工作流模板模型
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String   // 模板名称
  description String?  // 模板描述
  category    String?  // 模板分类（可选，便于归组）
  steps       String   // 工作流步骤数组（JSON 序列化的 WorkflowStep[]）
  globalParams String?  // 全局参数（JSON：批量数/比例/清晰度/水印/重试等）
  tags        String?  // 标签（JSON 数组）
  usageCount  Int      @default(0) // 使用次数统计
  isDefault   Boolean  @default(false) // 是否为默认模板
  isSystem    Boolean  @default(false) // 是否为系统预设模板（不可删除）

  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, isDefault])
  @@map("workflow_templates")
}

// WorkflowTemplate 字段说明:
// - steps: JSON 数组，每个元素为 { id, order, type, name, description, params, refTemplateId? }
//          type 包括: scene, background, upscale, watermark, outpaint，为 Phase 3 预留 workflow 类型
// - globalParams: JSON 对象，包含 { batchCount?, aspectRatio?, resolution?, watermarkEnabled?, autoRetry? }
// - tags: JSON 数组，便于用户分类和搜索
